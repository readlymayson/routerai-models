# Конфигурация парсера каталога routerai.ru
# Скопируйте в .env и при необходимости переопределите значения

# Базовый URL API (по умолчанию берётся из filter_config.json)
ROUTERAI_API_URL=https://routerai.ru/api/v1

# Таймауты HTTP-запросов (секунды)
ROUTERAI_TIMEOUT=30

# Путь к конфигурации ai-core (для compare_with_config.py и sync_configs.py)
# Полный путь к config.json, либо AI_CORE_ROOT + ai_core.config_path
AI_CORE_CONFIG=/home/dev/projects/ai-core/config/config.json

# Опциональный Bearer-токен для API routerai.ru (будущие live-тесты)
# ROUTERAI_API_KEY=
